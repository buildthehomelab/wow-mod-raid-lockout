[worldserver]

########################################
# mod-raid-lockout
#
# Sets how many days each raid's lockout lasts. Raids reset at Instance.ResetTimeHour
# (worldserver.conf, counted from midnight UTC) every N days.
#
# Every raid setting below takes a number of days from 1 to 30. 0 keeps the timer the raid already
# has (from MapDifficulty.dbc, or from mod-individual-progression for the 40-man versions). The
# worldserver log lists every changed raid and its stock timer at startup.
#
# Restart the worldserver after changing these. A shorter timer takes effect at the next reset
# hour after the restart; existing lockouts that would last longer are shortened too.
########################################

#
#    RaidLockout.Enable
#        Description: Master switch. 0 restores every raid's stock timer.
#        Default:     1
#

RaidLockout.Enable = 1

#
#    RaidLockout.RepeatableBossQuests
#        Description: Boss trophies can be handed in again. A Head of Onyxia, Head of Nefarian or
#                     Heart of Hakkar starts a one-time quest, and the core stops dropping a quest
#                     starter for a character who has done its quest. With 1, when a dungeon, raid
#                     or world boss (or a chest inside a dungeon or raid) drops an item that
#                     starts a quest, that quest and its follow-ups are forgotten for every group
#                     member who has finished them, so the item drops for them again: another of
#                     the rewards, or just the city buff. A character still needs a new item for
#                     every round. Not a raid timer: it works whatever RaidLockout.Enable is, and
#                     applies on .reload config.
#        Default:     1
#

RaidLockout.RepeatableBossQuests = 1

#
#    RaidLockout.RepeatableBossQuestChain
#        Description: The longest turn-in, in quests, that can be done again: the quest the item
#                     starts plus the follow-ups handed out after it. Head of Onyxia is 2 (Victory
#                     for the Alliance, then Celebrating Good Times). Longer ones are story chains
#                     (An Unsent Letter from Edwin VanCleef is 8) and stay one-time.
#        Default:     3
#

RaidLockout.RepeatableBossQuestChain = 3

########################################
# Vanilla
########################################

#
#    RaidLockout.ZulGurub
#        Description: Zul'Gurub. Days between resets (stock: 3).
#        Default:     0
#

RaidLockout.ZulGurub = 0

#
#    RaidLockout.RuinsOfAhnQiraj
#        Description: Ruins of Ahn'Qiraj (AQ20). Days between resets (stock: 3).
#        Default:     0
#

RaidLockout.RuinsOfAhnQiraj = 0

#
#    RaidLockout.MoltenCore
#        Description: Molten Core. Days between resets (stock: 7).
#        Default:     0
#

RaidLockout.MoltenCore = 0

#
#    RaidLockout.OnyxiasLair40
#        Description: Onyxia's Lair, 40-man version from mod-individual-progression. Days between resets (stock: 7).
#        Default:     0
#

RaidLockout.OnyxiasLair40 = 0

#
#    RaidLockout.BlackwingLair
#        Description: Blackwing Lair. Days between resets (stock: 7).
#        Default:     0
#

RaidLockout.BlackwingLair = 0

#
